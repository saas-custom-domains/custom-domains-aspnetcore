{
  // Local defaults for `dotnet run`, with the mock from compose.yaml.
  // host.docker.internal is how the mock reaches the app (webhooks).
  // Environment variables override these.
  "APP_HOSTS": "localhost,host.docker.internal",
  "APP_DOMAIN": "bookwell.app",
  "SCD_API_URL": "http://localhost:4010",
  "SCD_API_TOKEN": "scd_test_token",
  "SCD_ACCOUNT_UUID": "acc_local",
  "SCD_UPSTREAM_UUID": "upstream_local",
  "PROXY_AUTH_TOKEN": "local_proxy_token",
  "SCD_WEBHOOK_TOKEN": "local_webhook_token"
}
