{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  // Host filtering can't list your customers' domains, so it stays off.
  // CustomDomainMiddleware checks every host against the database
  // instead. See "Bad Request - Invalid Hostname" in the README.
  "AllowedHosts": "*"
}
